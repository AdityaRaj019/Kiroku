// Kiroku — Prisma Schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────

enum NotificationType {
  NEW_CHAPTER
  STATUS_CHANGE
  SYSTEM
}

enum MediaType {
  MANGA
  ANIME
}

enum LibraryStatus {
  READING
  COMPLETED
  PLAN_TO_READ
  DROPPED
  PAUSED
}

enum MangaStatus {
  ONGOING
  COMPLETED
  HIATUS
  CANCELLED
}

// ─── Models ──────────────────────────────────────────────────

model User {
  id               Int       @id @default(autoincrement())
  email            String    @unique
  name             String?
  passwordHash     String    @map("password_hash")
  refreshTokenHash String?   @map("refresh_token_hash")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  pushTokens    PushToken[]
  libraryItems  LibraryItem[]
  notifications Notification[]

  @@map("users")
}

model PushToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

model Manga {
  id          Int         @id @default(autoincrement())
  sourceId    String?     @unique @map("source_id")
  title       String
  slug        String      @unique
  coverUrl    String?     @map("cover_url")
  synopsis    String?
  author      String?
  status      MangaStatus @default(ONGOING)
  sourceUrl   String?     @map("source_url")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  chapters     Chapter[]
  libraryItems LibraryItem[]

  @@map("manga")
}

model Chapter {
  id          Int      @id @default(autoincrement())
  number      Float
  title       String?
  sourceUrl   String?  @map("source_url")
  mangaId     Int      @map("manga_id")
  releasedAt  DateTime @default(now()) @map("released_at")
  createdAt   DateTime @default(now()) @map("created_at")

  manga Manga @relation(fields: [mangaId], references: [id], onDelete: Cascade)

  @@unique([mangaId, number])
  @@index([mangaId])
  @@map("chapters")
}

model LibraryItem {
  id                  Int           @id @default(autoincrement())
  userId              Int           @map("user_id")
  mangaId             Int?          @map("manga_id")
  animeId             String?       @map("anime_id")
  mediaType           MediaType     @default(MANGA) @map("media_type")
  status              LibraryStatus @default(READING)
  progress            Int           @default(0)
  favorite            Boolean       @default(false)
  enableNotifications Boolean       @default(true) @map("enable_notifications")
  rating              Int?
  startDate           DateTime?     @map("start_date")
  endDate             DateTime?     @map("end_date")
  reReadCount         Int           @default(0) @map("re_read_count")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  manga Manga? @relation(fields: [mangaId], references: [id], onDelete: Cascade)

  @@unique([userId, mangaId])
  @@unique([userId, animeId])
  @@index([userId])
  @@index([mangaId])
  @@index([userId, status])
  @@index([userId, mediaType])
  @@map("library_items")
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int              @map("user_id")
  type      NotificationType
  title     String
  body      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}
